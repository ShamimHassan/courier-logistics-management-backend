# ─── CourierFlow Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in all values before running the server.
# NEVER commit .env with real secrets. Use render.yaml / Render dashboard
# to manage production secrets.

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Public-facing URL of this API (used for SSLCommerz callback URLs)
APP_BASE_URL=http://localhost:5000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database (Prisma Postgres) ───────────────────────────────────────────────
# Pooled connection (Prisma Data Proxy / pgBouncer)
DATABASE_URL="postgresql://username:password@localhost:5432/courierflow?schema=public"

# Direct connection (for migrations)
DIRECT_URL="postgresql://username:password@localhost:5432/courierflow?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_random_string_dev
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_random_string_dev2
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── SSLCommerz Payment Gateway ───────────────────────────────────────────────
# Sandbox credentials from https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_IS_SANDBOX=true
# Set SSLCOMMERZ_IS_SANDBOX=false for production

# ─── Google OAuth 2.0 (optional) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ─── Redis (optional — caching disabled gracefully when not set) ──────────────
# Format: redis://:password@host:port  or  rediss:// for TLS
REDIS_URL=

# ─── Stripe (legacy — kept for seeded test data compatibility) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cloudinary (optional — for proof-of-delivery photo upload) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
